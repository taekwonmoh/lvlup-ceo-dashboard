{
  "name": "lvlup-crm-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  // pg uses Node's net stack. Required for Hyperdrive's connectionString.
  "compatibility_flags": ["nodejs_compat"],
  // Sandbox testing only. Do not add a routes or custom domain block.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // Hyperdrive binding for a new Supabase Postgres project.
  // Do not reuse project xxyndswrierztzdbjvrd.
  // Leave this commented until the live Hyperdrive configuration id is filled in.
  // An empty id makes wrangler deploy fail, so this file still builds as-is.
  // Uncomment and set id from the Cloudflare dashboard (Storage & databases → Hyperdrive).
  // The Worker reads env.HYPERDRIVE.connectionString and never logs or returns it.
  // Local wrangler dev can set DATABASE_URL in worker/.dev.vars instead.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "REPLACE_WITH_HYPERDRIVE_ID"
  //   }
  // ],
  "rules": [
    { "type": "Text", "globs": ["**/*.csv"], "fallthrough": true }
  ],
  "vars": {
    "AUTHORIZENET_MODE": "sandbox",
    "BILLING_CHARGES_ENABLED": "0",
    "QBO_ENABLED": "0",
    "AUTOMATION_DELIVERY_ENABLED": "0",
    "PUSH_DELIVERY_ENABLED": "0",
    "WEBHOOK_DELIVERY_ENABLED": "0",
    "CRM_ALLOW_LOCAL_TOKENS": "0",
    "FIREBASE_PROJECT_ID": "lvlup-members-app"
  }
}
