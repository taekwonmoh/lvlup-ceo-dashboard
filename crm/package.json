{
  "name": "lvlup-crm",
  "private": true,
  "type": "module",
  "description": "LVLUP CRM backbone. Local only. Does not deploy and does not call live GymDesk, Firebase, or Authorize.net.",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:dry-run": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir /tmp/lvlup-crm-api-dry-run"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}
